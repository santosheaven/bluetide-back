# ============================================================
# BlueTide Backend — Environment Variables (Local Development)
# ============================================================
# Copy this file and rename to .env.local:
#   cp .env.example .env.local
#
# Then load with:
#   source .env.local
# ============================================================

# --- Required ---
export MONGODB_URI=mongodb://localhost:27017/bluetide
export JWT_SECRET=mi-clave-secreta-para-desarrollo-local-min-32-chars
export SPRING_PROFILES_ACTIVE=dev

# --- Optional: Email (without these, emails are logged but not sent) ---
# export MAIL_HOST=smtp.gmail.com
# export MAIL_PORT=587
# export MAIL_USERNAME=tu@gmail.com
# export MAIL_PASSWORD=tu-app-password

# --- Optional: Google OAuth2 ---
# export GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# export GOOGLE_CLIENT_SECRET=xxxxx

# --- Optional: JWT RS256 (if not set, uses HS256 with JWT_SECRET) ---
# export JWT_ALGORITHM=RS256
# export JWT_PRIVATE_KEY_PATH=/path/to/private.pem
# export JWT_PUBLIC_KEY_PATH=/path/to/public.pem


