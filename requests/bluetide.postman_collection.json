{
  "info": {
    "_postman_id": "bluetide-collection",
    "name": "BlueTide API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "Health",
          "request": { "method": "GET", "url": "{{base}}/api/public/health" }
        },
        { "name": "Info", "request": { "method": "GET", "url": "{{base}}/api/public/info" } }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base}}/api/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"displayName\": \"Alice\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"secret123\"\n}" }
          }
        },
        {
          "name": "Login",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{base}}/api/auth/login", "body": { "mode": "raw", "raw": "{\"email\":\"alice@example.com\",\"password\":\"secret123\"}" } }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        { "name": "List Users", "request": { "method": "GET", "url": "{{base}}/api/users", "header": [{ "key": "Authorization", "value": "Bearer {{JWT}}" }] } },
        { "name": "Get User", "request": { "method": "GET", "url": "{{base}}/api/users/{{userId}}", "header": [{ "key": "Authorization", "value": "Bearer {{JWT}}" }] } },
        { "name": "Create User", "request": { "method": "POST", "url": "{{base}}/api/users", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{JWT}}" }], "body": { "mode": "raw", "raw": "{\"email\":\"bob@example.com\",\"password\":\"pwd12345\",\"displayName\":\"Bob\"}" } } }
      ]
    },
    {
      "name": "Companies",
      "item": [
        { "name": "List Companies", "request": { "method": "GET", "url": "{{base}}/api/companies", "header": [{ "key": "Authorization", "value": "Bearer {{JWT}}" }] } },
        { "name": "Create Company", "request": { "method": "POST", "url": "{{base}}/api/companies", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{JWT}}" }], "body": { "mode": "raw", "raw": "{\"name\":\"Acme Property\",\"managerIds\":[\"user1\"]}" } } }
      ]
    },
    {
      "name": "Properties",
      "item": [
        { "name": "Create Property", "request": { "method": "POST", "url": "{{base}}/api/properties", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{JWT}}" }], "body": { "mode": "raw", "raw": "{\"address\":\"123 Main St\",\"type\":\"APARTMENT\"}" } } }
      ]
    },
    {
      "name": "Services",
      "item": [
        { "name": "Create ServiceRequest", "request": { "method": "POST", "url": "{{base}}/api/services", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{JWT}}" }], "body": { "mode": "raw", "raw": "{\"propertyId\":\"prop1\",\"requesterId\":\"user1\",\"serviceType\":\"PLUMBING\",\"description\":\"Leak\"}" } } }
      ]
    }
  ],
  "variable": [
    { "key": "base", "value": "http://localhost:8080" },
    { "key": "JWT", "value": "" },
    { "key": "userId", "value": "user-id-1" }
  ]
}

